# /etc/systemd/system/gunicorn.service
[Unit]
Description=gunicorn daemon
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/portfolio/backend
RuntimeDirectory=gunicorn
EnvironmentFile=/etc/gunicorn.env
ExecStart=/home/ubuntu/portfolio/backend/venv/bin/python3 -m gunicorn --access-logfile - --workers 3 --bind unix:/run/gunicorn/socket core.wsgi:application

[Install]
WantedBy=multi-user.target
