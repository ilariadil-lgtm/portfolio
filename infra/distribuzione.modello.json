{
  "CallerReference": "SEGNAPOSTO_RIFERIMENTO",
  "Comment": "ilariadiliberto.com — statico da S3, /api dall'EC2",
  "Enabled": true,
  "HttpVersion": "http2and3",
  "PriceClass": "PriceClass_100",
  "DefaultRootObject": "index.html",

  "Aliases": {
    "Quantity": 2,
    "Items": ["ilariadiliberto.com", "www.ilariadiliberto.com"]
  },

  "Origins": {
    "Quantity": 2,
    "Items": [
      {
        "Id": "sito-s3",
        "DomainName": "SEGNAPOSTO_BUCKET.s3.eu-south-1.amazonaws.com",
        "OriginAccessControlId": "SEGNAPOSTO_OAC",
        "S3OriginConfig": { "OriginAccessIdentity": "" },
        "OriginShield": { "Enabled": false }
      },
      {
        "Id": "api-ec2",
        "DomainName": "SEGNAPOSTO_ORIGINE_API",
        "CustomOriginConfig": {
          "HTTPPort": 80,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "https-only",
          "OriginSslProtocols": { "Quantity": 1, "Items": ["TLSv1.2"] },
          "OriginReadTimeout": 30,
          "OriginKeepaliveTimeout": 5
        }
      }
    ]
  },

  "DefaultCacheBehavior": {
    "TargetOriginId": "sito-s3",
    "ViewerProtocolPolicy": "redirect-to-https",
    "AllowedMethods": {
      "Quantity": 2,
      "Items": ["GET", "HEAD"],
      "CachedMethods": { "Quantity": 2, "Items": ["GET", "HEAD"] }
    },
    "Compress": true,
    "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
    "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
    "FunctionAssociations": {
      "Quantity": 1,
      "Items": [
        { "EventType": "viewer-request", "FunctionARN": "SEGNAPOSTO_FUNZIONE" }
      ]
    }
  },

  "CacheBehaviors": {
    "Quantity": 1,
    "Items": [
      {
        "PathPattern": "/api/*",
        "TargetOriginId": "api-ec2",
        "ViewerProtocolPolicy": "https-only",
        "AllowedMethods": {
          "Quantity": 7,
          "Items": ["GET", "HEAD", "POST", "PUT", "PATCH", "OPTIONS", "DELETE"],
          "CachedMethods": { "Quantity": 2, "Items": ["GET", "HEAD"] }
        },
        "Compress": true,
        "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
        "OriginRequestPolicyId": "216adef6-5c7f-47e4-b989-5492eafa07d3"
      }
    ]
  },

  "ViewerCertificate": {
    "ACMCertificateArn": "SEGNAPOSTO_CERTIFICATO",
    "SSLSupportMethod": "sni-only",
    "MinimumProtocolVersion": "TLSv1.2_2021",
    "CertificateSource": "acm"
  },

  "CustomErrorResponses": {
    "Quantity": 1,
    "Items": [
      {
        "ErrorCode": 404,
        "ResponsePagePath": "/index.html",
        "ResponseCode": "404",
        "ErrorCachingMinTTL": 60
      }
    ]
  }
}
